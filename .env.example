# LexCorp — demo defaults for docker compose
# Copied to .env by `make setup`. Hostnames are Docker service names.

# ── App ───────────────────────────────────────────
APP_ENV=dev
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=9100

# ── PostgreSQL (service: postgres) ────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lexcorp
POSTGRES_USER=cso
POSTGRES_PASSWORD=cso_secret_change_me

# ── Redis (service: redis) ────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_me

# Celery reads these directly (not via Settings)
CELERY_BROKER_URL=redis://:redis_secret_change_me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_secret_change_me@redis:6379/1

# ── Ollama (service: ollama) ──────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b

# ── Auth (PASETO v4.local — 32+ chars) ────────────
PASETO_SECRET_KEY=lexcorp-demo-secret-key-32bytes!!

# ── Observability ─────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAME=lexcorp-api

# ── CORS ──────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:9000,http://localhost:9100
